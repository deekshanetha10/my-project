# CloudIntelliGuard Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env to version control.

# === Database ===
DATABASE_URL=postgresql+asyncpg://cig_user:cig_password@localhost:5432/cig_db

# === JWT ===
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === App ===
APP_NAME=CloudIntelliGuard
DEBUG=false
DEMO_MODE=false

# === Admin seed user (created on first startup) ===
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# === Adaptive Time Window ===
DEFAULT_WINDOW_TYPE=fixed
DEFAULT_WINDOW_HOURS=24
ADAPTIVE_LOW_THRESHOLD=100
ADAPTIVE_HIGH_THRESHOLD=1000

# === GNN Hyperparameters ===
GNN_HIDDEN_DIM=64
GNN_OUTPUT_DIM=32
GNN_NUM_LAYERS=2
GNN_DROPOUT=0.3
ANOMALY_THRESHOLD=0.5

# === Paths ===
DATA_DIR=data
MODEL_DIR=models/trained
CHECKPOINT_DIR=models/checkpoints

# === Logging ===
LOG_LEVEL=INFO
